{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} \ue0b1",
          "foreground": "#ffc107",
          "background": "#18354c",
          "type": "os",
          "style": "plain"
        },
        {
          "template": " \uf0e7 ",
          "foreground": "#ffc107",
          "background": "#18354c",
          "type": "root",
          "style": "plain"
        },
        {
          "properties": {
            "style": "full",
            "template": " {{ .Path }} "
          },
          "foreground": "#ffc107",
          "background": "#18354c",
          "type": "path",
          "style": "plain"
        },
        {
          "properties": {
            "fetch_status": true,
            "template": "<#ffc107>\ue0b1 </>{{ .HEAD }} {{ .BranchStatus }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Staging.Changed) (.Working.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0}} \uf692 {{ .StashCount }}{{ end }}{{ if gt .WorktreeCount 0}} \uf1bb {{ .WorktreeCount }}{{ end }} "
          },
          "foreground": "#D4E157",
          "background": "#18354c",
          "type": "git",
          "style": "plain"
        },
        {
          "template": "\ue0b0",
          "foreground": "#18354c",
          "background": "transparent",
          "type": "text",
          "style": "plain"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
		  "template": " {{ .CurrentDate | date .Format }} \uf017 ",
		  "time_format": "15:04:05",
          "foreground": "#D4E157",
          "background": "#546E7A",
          "type": "time",
          "style": "plain"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "❯ ",
          "foreground": "#4186d9",
          "type": "text",
          "style": "plain",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#FF5252{{ end }}"
          ]
        }
      ],
      "newline": true
    }
  ],
  "version": 3
}
